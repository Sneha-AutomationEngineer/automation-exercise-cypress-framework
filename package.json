{
  "name": "automation-exercise-cypress-framework",
  "version": "1.0.0",
  "description": "",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:smoke": "cypress run --spec \"cypress/e2e/ui/login.cy.js,cypress/e2e/ui/logout.cy.js,cypress/e2e/ui/registerUser.cy.js,cypress/e2e/ui/products.cy.js,cypress/e2e/ui/searchProducts.cy.js,cypress/e2e/ui/addProducts.cy.js,cypress/e2e/ui/placeOrderLoginBeforeCheckout.cy.js,cypress/e2e/ui/verifyAddress.cy.js\"",
    "test:regression": "cypress run",
    "cy:smoke:edge": "cypress run --browser edge --spec \"cypress/e2e/ui/login.cy.js,cypress/e2e/ui/logout.cy.js,cypress/e2e/ui/registerUser.cy.js,cypress/e2e/ui/products.cy.js,cypress/e2e/ui/searchProducts.cy.js,cypress/e2e/ui/addProducts.cy.js,cypress/e2e/ui/placeOrderLoginBeforeCheckout.cy.js,cypress/e2e/ui/verifyAddress.cy.js\"",
    "cy:smoke:firefox": "cypress run --browser firefox --spec \"cypress/e2e/ui/login.cy.js,cypress/e2e/ui/logout.cy.js,cypress/e2e/ui/registerUser.cy.js,cypress/e2e/ui/products.cy.js,cypress/e2e/ui/searchProducts.cy.js,cypress/e2e/ui/addProducts.cy.js,cypress/e2e/ui/placeOrderLoginBeforeCheckout.cy.js,cypress/e2e/ui/verifyAddress.cy.js\"",
    "cy:regression:edge": "cypress run --browser edge",
    "cy:regression:firefox": "cypress run --browser firefox"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^14.5.4",
    "cypress-mochawesome-reporter": "^5.0.0"
  }
}
